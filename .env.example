# ============================================================
# 百炼 API
# ============================================================

# 填写你自己的百炼 API Key
DASHSCOPE_API_KEY=

# 百炼 OpenAI 兼容接口
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 使用的生成模型
DASHSCOPE_MODEL=qwen-plus-2025-07-28


# ============================================================
# AI / RAG 配置
# ============================================================

# Ollama Embedding 模型
EMBED_MODEL=nomic-embed-text

# RAG 文档切块大小
CHUNK_SIZE=500

# RAG 切块重叠长度
CHUNK_OVERLAP=100

# 最多召回多少个知识库片段
RAG_TOP_K=3

# RAG 相似度最低通过阈值
RAG_SIMILARITY_THRESHOLD=0.63
